{
    "title": "eBay Sold & Completed Listings Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "query": {
            "title": "Search Keyword, Model, or UPC/EAN",
            "type": "string",
            "description": "Product name, part number, trading card, or barcode to analyze.",
            "editor": "textfield",
            "prefill": "iPhone 15 Pro 128GB"
        },
        "country": {
            "title": "eBay Marketplace",
            "type": "string",
            "description": "Select the target regional eBay store.",
            "editor": "select",
            "default": "US",
            "enum": ["US", "UK", "DE", "ES", "FR", "IT", "AU", "CA"],
            "enumTitles": [
                "United States (ebay.com)",
                "United Kingdom (ebay.co.uk)",
                "Germany (ebay.de)",
                "Spain (ebay.es)",
                "France (ebay.fr)",
                "Italy (ebay.it)",
                "Australia (ebay.com.au)",
                "Canada (ebay.ca)"
            ]
        },
        "soldOnly": {
            "title": "Sold & Completed Listings Only",
            "type": "boolean",
            "description": "When enabled, extracts actual closed sales instead of active asking prices.",
            "default": true
        },
        "condition": {
            "title": "Item Condition",
            "type": "string",
            "description": "Filter results by item condition.",
            "editor": "select",
            "default": "ALL",
            "enum": ["ALL", "1000", "1500", "3000", "7000"],
            "enumTitles": [
                "All Conditions",
                "Brand New",
                "Open Box",
                "Used / Pre-Owned",
                "For Parts or Not Working"
            ]
        },
        "maxItems": {
            "title": "Maximum Listings",
            "type": "integer",
            "description": "Maximum number of listings to extract.",
            "default": 60,
            "minimum": 1,
            "maximum": 1200
        },
        "proxyConfiguration": {
            "title": "Proxy Configuration",
            "type": "object",
            "description": "Apify Proxy settings (Residential recommended for heavy US/UK volume).",
            "editor": "proxy",
            "default": {
                "useApifyProxy": true
            }
        }
    },
    "required": ["query"]
}
